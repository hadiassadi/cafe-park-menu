diff --git a/tests/coupon-utils.test.ts b/tests/coupon-utils.test.ts
new file mode 100644
index 0000000..00beab0
--- /dev/null
+++ b/tests/coupon-utils.test.ts
@@ -0,0 +1,39 @@
+import { describe, it, expect } from 'vitest'
+import { isCouponEligible } from '../lib/coupon-utils'
+
+// قاعده: مقدار خود محصول اولویت دارد؛ مقدار نامشخص یعنی ارث از دسته؛ پیش‌فرض شامل تخفیف
+// نکته: تایپ Product فیلد را boolean|undefined می‌داند، اما ستون در دیتابیس nullable است
+// و سوابیس در ران‌تایم ممکن است null بدهد؛ تابع هر دو را درست هندل می‌کند.
+const elig = (v: unknown) => ({ coupon_eligible: v as boolean | undefined })
+
+describe('isCouponEligible', () => {
+  it('محصول true → همیشه شامل تخفیف حتی اگر دسته false باشد', () => {
+    expect(isCouponEligible(elig(true), { coupon_eligible: false })).toBe(true)
+  })
+
+  it('محصول false → همیشه مستثنا حتی اگر دسته true باشد', () => {
+    expect(isCouponEligible(elig(false), { coupon_eligible: true })).toBe(false)
+  })
+
+  it('محصول نامشخص (null ران‌تایم) + دسته false → مستثنا (ارث از دسته)', () => {
+    expect(isCouponEligible(elig(null), { coupon_eligible: false })).toBe(false)
+  })
+
+  it('محصول نامشخص + دسته true → شامل تخفیف', () => {
+    expect(isCouponEligible(elig(null), { coupon_eligible: true })).toBe(true)
+  })
+
+  it('محصول نامشخص + دسته نامشخص → پیش‌فرض شامل تخفیف', () => {
+    expect(isCouponEligible(elig(null), { coupon_eligible: null as unknown as boolean })).toBe(true)
+  })
+
+  it('بدون دسته → پیش‌فرض شامل تخفیف', () => {
+    expect(isCouponEligible(elig(null))).toBe(true)
+  })
+
+  it('فیلد undefined محصول مثل null رفتار می‌کند', () => {
+    expect(isCouponEligible({}, { coupon_eligible: false })).toBe(false)
+    expect(isCouponEligible({}, { coupon_eligible: true })).toBe(true)
+    expect(isCouponEligible({})).toBe(true)
+  })
+})
diff --git a/tests/order-visibility.test.ts b/tests/order-visibility.test.ts
new file mode 100644
index 0000000..bbd003a
--- /dev/null
+++ b/tests/order-visibility.test.ts
@@ -0,0 +1,51 @@
+import { describe, it, expect } from 'vitest'
+import { isOrderVisibleToAdmin } from '../lib/orders/visibility'
+
+// قاعده: پرداخت حضوری همیشه دیده می‌شود؛ آنلاین تا وقتی رسید/یادداشت نداشته باشد مخفی است
+describe('isOrderVisibleToAdmin', () => {
+  it('بدون روش پرداخت → دیده می‌شود', () => {
+    expect(isOrderVisibleToAdmin({})).toBe(true)
+  })
+
+  it('نقدی/کارت‌خوان → همیشه دیده می‌شود حتی بدون وضعیت', () => {
+    expect(isOrderVisibleToAdmin({ payment_method: 'cash' })).toBe(true)
+    expect(isOrderVisibleToAdmin({ payment_method: 'card' })).toBe(true)
+  })
+
+  it('آنلاین پرداخت‌شده یا بخشی‌پرداخت‌شده → دیده می‌شود', () => {
+    expect(isOrderVisibleToAdmin({ payment_method: 'online', payment_status: 'paid' })).toBe(true)
+    expect(isOrderVisibleToAdmin({ payment_method: 'online', payment_status: 'partial' })).toBe(true)
+  })
+
+  it('آنلاین در انتظار بررسی + رسید → دیده می‌شود', () => {
+    expect(
+      isOrderVisibleToAdmin({
+        payment_method: 'online',
+        payment_status: 'pending_review',
+        payment_receipt_url: 'https://x/receipt.png',
+      })
+    ).toBe(true)
+  })
+
+  it('آنلاین در انتظار بررسی + یادداشت متنی → دیده می‌شود', () => {
+    expect(
+      isOrderVisibleToAdmin({
+        payment_method: 'online',
+        payment_status: 'pending_review',
+        payment_note: 'کارت به کارت شد',
+      })
+    ).toBe(true)
+  })
+
+  it('آنلاین در انتظار بررسی بدون هیچ مدرکی → مخفی', () => {
+    expect(
+      isOrderVisibleToAdmin({ payment_method: 'online', payment_status: 'pending_review' })
+    ).toBe(false)
+  })
+
+  it('آنلاین با وضعیت دیگر → مخفی', () => {
+    expect(isOrderVisibleToAdmin({ payment_method: 'online', payment_status: 'unpaid' })).toBe(
+      false
+    )
+  })
+})
diff --git a/tests/rate-limit.test.ts b/tests/rate-limit.test.ts
new file mode 100644
index 0000000..23239f2
--- /dev/null
+++ b/tests/rate-limit.test.ts
@@ -0,0 +1,91 @@
+import { describe, it, expect, vi, afterEach } from 'vitest'
+import { getClientIp, rateLimit, tooMany } from '../lib/rate-limit'
+
+function req(headers: Record<string, string> = {}): Request {
+  return new Request('https://test.local/api', { headers })
+}
+
+afterEach(() => {
+  vi.useRealTimers()
+})
+
+describe('getClientIp', () => {
+  it('اولین IP از x-forwarded-for (کلاینت واقعی پشت پروکسی)', () => {
+    expect(getClientIp(req({ 'x-forwarded-for': '1.2.3.4, 10.0.0.1' }))).toBe('1.2.3.4')
+  })
+
+  it('فاصله‌ی اضافه در هدر نادیده گرفته می‌شود', () => {
+    expect(getClientIp(req({ 'x-forwarded-for': '  5.5.5.5 , 10.0.0.1' }))).toBe('5.5.5.5')
+  })
+
+  it('بدون forwarded → x-real-ip', () => {
+    expect(getClientIp(req({ 'x-real-ip': '7.7.7.7' }))).toBe('7.7.7.7')
+  })
+
+  it('بدون هیچ هدری → unknown', () => {
+    expect(getClientIp(req())).toBe('unknown')
+  })
+})
+
+describe('rateLimit — پنجره‌ی لغزان', () => {
+  // هر تست با name جدا تا bucketهای ماژول مشترک، تداخل نکنند
+  it('تا سقف مجاز عبور می‌کند و بعد قفل می‌شود', () => {
+    const r = req({ 'x-forwarded-for': '9.9.9.9' })
+    const a = rateLimit(r, 't1', 3, 60_000)
+    const b = rateLimit(r, 't1', 3, 60_000)
+    const c = rateLimit(r, 't1', 3, 60_000)
+    expect([a.ok, b.ok, c.ok]).toEqual([true, true, true])
+    expect([a.remaining, b.remaining, c.remaining]).toEqual([2, 1, 0])
+
+    const d = rateLimit(r, 't1', 3, 60_000)
+    expect(d.ok).toBe(false)
+    expect(d.remaining).toBe(0)
+    expect(d.retryAfterSec).toBeGreaterThanOrEqual(1)
+    expect(d.retryAfterSec).toBeLessThanOrEqual(60)
+  })
+
+  it('extraKey متفاوت → bucket جدا (دو دستگاه مستقل)', () => {
+    const r = req({ 'x-forwarded-for': '9.9.9.9' })
+    expect(rateLimit(r, 't2', 1, 60_000, 'device-a').ok).toBe(true)
+    expect(rateLimit(r, 't2', 1, 60_000, 'device-a').ok).toBe(false)
+    expect(rateLimit(r, 't2', 1, 60_000, 'device-b').ok).toBe(true)
+  })
+
+  it('نام متفاوت → bucket جدا', () => {
+    const r = req({ 'x-forwarded-for': '9.9.9.9' })
+    expect(rateLimit(r, 't3-a', 1, 60_000).ok).toBe(true)
+    expect(rateLimit(r, 't3-a', 1, 60_000).ok).toBe(false)
+    expect(rateLimit(r, 't3-b', 1, 60_000).ok).toBe(true)
+  })
+
+  it('IP متفاوت → bucket جدا', () => {
+    expect(rateLimit(req({ 'x-forwarded-for': '8.8.8.8' }), 't4', 1, 60_000).ok).toBe(true)
+    expect(rateLimit(req({ 'x-forwarded-for': '8.8.8.8' }), 't4', 1, 60_000).ok).toBe(false)
+    expect(rateLimit(req({ 'x-forwarded-for': '8.8.4.4' }), 't4', 1, 60_000).ok).toBe(true)
+  })
+
+  it('پایان پنجره → شمارنده صفر می‌شود', () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(new Date('2026-11-07T10:00:00Z'))
+    const r = req({ 'x-forwarded-for': '6.6.6.6' })
+    expect(rateLimit(r, 't5', 2, 60_000).ok).toBe(true)
+    expect(rateLimit(r, 't5', 2, 60_000).ok).toBe(true)
+    expect(rateLimit(r, 't5', 2, 60_000).ok).toBe(false)
+
+    vi.setSystemTime(new Date('2026-11-07T10:01:01Z')) // 61 ثانیه بعد
+    const after = rateLimit(r, 't5', 2, 60_000)
+    expect(after.ok).toBe(true)
+    expect(after.remaining).toBe(1)
+  })
+})
+
+describe('tooMany — پاسخ ۴۲۹', () => {
+  it('status و Retry-After و بدنه درست', async () => {
+    const res = tooMany({ ok: false, remaining: 0, retryAfterSec: 37 })
+    expect(res.status).toBe(429)
+    expect(res.headers.get('Retry-After')).toBe('37')
+    expect(res.headers.get('Cache-Control')).toBe('no-store')
+    const body = await res.json()
+    expect(body.error).toContain('تعداد درخواست')
+  })
+})
