@@ -0,0 +1,39 @@
+// lib/wallet/labels.ts
+
+/**
+ * برچسب‌های فارسی تراکنش‌های کیف پول — نسخه‌ی client-safe.
+ * عمداً بدون import 'server-only' تا کامپوننت‌های مشتری (my-orders) هم بتوانند استفاده کنند.
+ * نسخه‌ی سرویس‌ساید معادل در lib/wallet/wallet.ts (WALLET_KIND_LABELS) نگهداری می‌شود؛
+ * برچسب‌های مشترک باید هم‌قد بمانند.
+ */
+
+export const WALLET_CLIENT_KIND_LABELS: Record<string, string> = {
+  admin_charge: 'شارژ توسط ادمین',
+  online_charge: 'شارژ آنلاین',
+  refund: 'بازگشت وجه',
+  spend: 'پرداخت سفارش',
+  adjust: 'اصلاح حساب',
+}
+
+export function walletTxKindLabel(kind: string): string {
+  return WALLET_CLIENT_KIND_LABELS[kind] ?? kind
+}
+
+export const WALLET_STATUS_LABELS: Record<string, string> = {
+  settled: 'تسویه شده',
+  pending: 'در انتظار',
+  failed: 'ناموفق',
+}
+
+/** ردیف‌های قدیمی status=null دارند — همان تسویه‌شده معنا می‌دهند */
+export function walletTxStatusLabel(status: string | null | undefined): string {
+  if (!status) return WALLET_STATUS_LABELS.settled
+  return WALLET_STATUS_LABELS[status] ?? status
+}
+
+export function walletTxKindIcon(kind: string): string {
+  if (kind === 'refund') return '↩️'
+  if (kind === 'spend') return '🧾'
+  if (kind === 'adjust') return '⚖️'
+  return '💰' // admin_charge / online_charge
+}
diff --git a/tests/wallet-labels.test.ts b/tests/wallet-labels.test.ts
new file mode 100644
index 0000000..be18d96
--- /dev/null
+++ b/tests/wallet-labels.test.ts
@@ -0,0 +1,39 @@
+import { describe, it, expect } from 'vitest'
+import {
+  walletTxKindLabel,
+  walletTxStatusLabel,
+  walletTxKindIcon,
+} from '../lib/wallet/labels'
+
+describe('برچسب‌های تراکنش کیف پول (سمت مشتری)', () => {
+  it('انواع شناخته‌شده برچسب فارسی دارند', () => {
+    expect(walletTxKindLabel('admin_charge')).toBe('شارژ توسط ادمین')
+    expect(walletTxKindLabel('online_charge')).toBe('شارژ آنلاین')
+    expect(walletTxKindLabel('refund')).toBe('بازگشت وجه')
+    expect(walletTxKindLabel('spend')).toBe('پرداخت سفارش')
+    expect(walletTxKindLabel('adjust')).toBe('اصلاح حساب')
+  })
+
+  it('نوع ناشناخته بدون تغییر برمی‌گردد', () => {
+    expect(walletTxKindLabel('mystery')).toBe('mystery')
+    expect(walletTxKindLabel('')).toBe('')
+  })
+
+  it('وضعیت‌ها برچسب دارند و null/خالی تسویه‌شده معنا می‌دهد', () => {
+    expect(walletTxStatusLabel('settled')).toBe('تسویه شده')
+    expect(walletTxStatusLabel('pending')).toBe('در انتظار')
+    expect(walletTxStatusLabel('failed')).toBe('ناموفق')
+    expect(walletTxStatusLabel(null)).toBe('تسویه شده')
+    expect(walletTxStatusLabel(undefined)).toBe('تسویه شده')
+    expect(walletTxStatusLabel('weird')).toBe('weird')
+  })
+
+  it('آیکون هر نوع مشخص است', () => {
+    expect(walletTxKindIcon('refund')).toBe('↩️')
+    expect(walletTxKindIcon('spend')).toBe('🧾')
+    expect(walletTxKindIcon('adjust')).toBe('⚖️')
+    expect(walletTxKindIcon('admin_charge')).toBe('💰')
+    expect(walletTxKindIcon('online_charge')).toBe('💰')
+    expect(walletTxKindIcon('ناشناخته')).toBe('💰')
+  })
+})
