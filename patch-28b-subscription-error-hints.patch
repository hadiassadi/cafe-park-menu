+/**
+ * پیام فارسیِ دقیق برای خطاهای PostgREST — تا صفحه‌ی ادمین علت واقعی را نشان دهد
+ * (جدولِ نبود = مایگریشن در پروژه‌ی اشتباه یا اجرای ناقص، ستونِ نبود، متغیر محیطی)
+ */
+function dbErr(e: any, fallback: string): string {
+  const code = String(e?.code ?? '')
+  const msg = String(e?.message ?? '')
+  if (code === 'PGRST205' || /Could not find the table|schema cache/i.test(msg)) {
+    return (
+      `${fallback} — جدول در دیتابیسِ متصل به اپ پیدا نشد (${code || 'PGRST205'}): ` +
+      `فایل 20261112_subscription_plans.sql را در همان پروژه‌ی Supabase اجرا کن که NEXT_PUBLIC_SUPABASE_URL به آن اشاره می‌کند؛ ` +
+      `بعدش «NOTIFY pgrst, 'reload schema';» را یک بار بزن و صفحه را رفرش کن`
+    )
+  }
+  if (code === 'PGRST427' || /column .* does not exist/i.test(msg)) {
+    return (
+      `${fallback} — ستون مورد انتظار در دیتابیس نیست (${code || 'PGRST427'}): ` +
+      `مایگریشن ۲۸ ناقص اجرا شده؛ فایل 20261112_subscription_plans.sql را کامل و بدون خطا اجرا کن`
+    )
+  }
+  if (/Missing Supabase admin env/i.test(msg)) {
+    return `${fallback} — متغیر محیطی SUPABASE_SERVICE_ROLE_KEY تنظیم نشده (Vercel یا .env.local)`
+  }
+  return msg ? `${fallback} (${code || 'DB'}: ${msg.slice(0, 140)})` : fallback
+}
