From 2b6ac2da0b764d2e0ccf9de3504bb93f06b5241d Mon Sep 17 00:00:00 2001
From: Z User <z@container>
Date: Sun, 8 Nov 2026 18:42:45 +0000
Subject: [PATCH] feat: customer panel mobile redesign
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- نوار بخش‌های پایین (bottom nav) در موبایل با نشانگر فعال + بج بدهی؛ تب‌های بالا فقط دسکتاپ
- کارت پروفایل فشرده: آواتار حرفی + نام/شماره + چیپ عضویت باشگاه + آمار ۳تایی بدون واحد نیمه‌افتاده
- حذف باکس سبز عضویت و متن‌های اضافه؛ توضیح کیف پول به یک خط
- حالت ورود کیف پول: دکمه پیامکی فقط وقتی پیامک تنظیم است؛ متن خنثی به‌جای پیام مدیریتی
- رفع نشت پیام «کلید کاوه‌نگار را در پنل ادمین وارد کنید» به UI مشتری در otp/send
---
 app/api/auth/otp/send/route.ts   |   7 +-
 app/globals.css                  | 183 +++++++++++++++++++++++++
 app/my-orders/MyOrdersClient.tsx | 224 +++++++++++++++++--------------
 3 files changed, 314 insertions(+), 100 deletions(-)

diff --git a/app/api/auth/otp/send/route.ts b/app/api/auth/otp/send/route.ts
index 00f7e77..adfe80a 100644
--- a/app/api/auth/otp/send/route.ts
+++ b/app/api/auth/otp/send/route.ts
@@ -39,7 +39,12 @@ export async function POST(req: NextRequest) {
     const db = supabaseAdmin()
     const cfg = await fetchSmsConfig(db)
     if (cfg.error || !cfg.config) {
-      return NextResponse.json({ error: cfg.error ?? 'پیامک تنظیم نشده است' }, { status: 503 })
+      // جزئیات فنی فقط در لاگ سرور می‌ماند؛ به مشتری پیام خنثی داده می‌شود
+      console.error('[otp/send] sms not configured:', cfg.error)
+      return NextResponse.json(
+        { error: 'فعلاً ورود با کد پیامکی غیرفعال است؛ از مدیر کافه کمک بگیر' },
+        { status: 503 }
+      )
     }
 
     const code = generateOtpCode()
diff --git a/app/globals.css b/app/globals.css
index 9a6f662..108e5ec 100644
--- a/app/globals.css
+++ b/app/globals.css
@@ -14780,3 +14780,186 @@ a.cat {
   font-weight: normal;
   color: #766f64;
 }
+
+/* ─── پنل مشتری: نوار تب پایین (موبایل) / تب بالا (دسکتاپ) + کارت پروفایل فشرده ─── */
+.panel-top-tabs {
+  display: flex;
+  width: 100%;
+  border-bottom: 1px solid #e3ddd2;
+}
+
+.panel-bottom-nav {
+  display: none;
+}
+
+@media (max-width: 767px) {
+  .panel-top-tabs {
+    display: none;
+  }
+
+  .panel-bottom-nav {
+    display: flex;
+    position: fixed;
+    bottom: 0;
+    left: 0;
+    right: 0;
+    z-index: 40;
+    background: #fffdf9;
+    border-top: 1px solid #e3ddd2;
+    box-shadow: 0 -4px 16px rgba(41, 37, 31, 0.07);
+    padding-bottom: env(safe-area-inset-bottom, 0);
+  }
+
+  .panel-bottom-nav button {
+    flex: 1;
+    position: relative;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 2px;
+    padding: 8px 4px 10px;
+    background: transparent;
+    border: none;
+    font-family: inherit;
+    font-size: 10.5px;
+    font-weight: 600;
+    color: #766f64;
+    cursor: pointer;
+  }
+
+  .panel-bottom-nav button .panel-nav-icon {
+    font-size: 19px;
+    line-height: 1.2;
+  }
+
+  .panel-nav-badge {
+    position: absolute;
+    top: 3px;
+    left: calc(50% + 6px);
+    background: #9b3c32;
+    color: #fff;
+    border-radius: 999px;
+    font-size: 9.5px;
+    font-weight: 700;
+    min-width: 16px;
+    height: 16px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 0 4px;
+  }
+}
+
+.panel-profile-card {
+  background: #fffdf9;
+  border: 1px solid #e3ddd2;
+  border-radius: 14px;
+  padding: 12px 14px;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.panel-profile-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+
+.panel-avatar {
+  width: 40px;
+  height: 40px;
+  flex-shrink: 0;
+  border-radius: 50%;
+  background: linear-gradient(135deg, #9a6b3f 0%, #6b4f3a 100%);
+  color: #fff;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 17px;
+  font-weight: 800;
+}
+
+.panel-profile-meta {
+  flex: 1;
+  min-width: 0;
+}
+
+.panel-profile-meta strong {
+  display: block;
+  font-size: 15px;
+  color: #29251f;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.panel-profile-meta small {
+  color: #766f64;
+  font-size: 11.5px;
+}
+
+.panel-membership-chip {
+  flex-shrink: 0;
+  max-width: 150px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  background: #e5f0e6;
+  color: #2d5d3e;
+  border: 1px solid #b9dcc4;
+  border-radius: 999px;
+  padding: 4px 10px;
+  font-size: 11px;
+  font-weight: 700;
+}
+
+.panel-stats {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 8px;
+  width: 100%;
+}
+
+.panel-stat {
+  background: #fff;
+  border: 1px solid #ebe6de;
+  border-radius: 10px;
+  padding: 10px 6px;
+  text-align: center;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+
+.panel-stat strong {
+  font-size: 14px;
+  color: #6b4f3a;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.panel-stat strong .panel-unit {
+  font-style: normal;
+  font-size: 10px;
+  color: #766f64;
+}
+
+.panel-stat small {
+  font-size: 10.5px;
+  color: #766f64;
+}
+
+.panel-balance-strip {
+  background: #e5f0e6;
+  border: 1px solid #b9dcc4;
+  color: #2d5d3e;
+  border-radius: 10px;
+  padding: 8px 12px;
+  font-size: 12.5px;
+  font-weight: 700;
+  text-align: center;
+}
