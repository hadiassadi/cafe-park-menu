diff --git a/lib/wallet/wallet.ts b/lib/wallet/wallet.ts
new file mode 100644
index 0000000..320ed40
--- /dev/null
+++ b/lib/wallet/wallet.ts
@@ -0,0 +1,136 @@
+import 'server-only'
+import { cookies } from 'next/headers'
+import { supabaseAdmin } from '../supabase/server' // ایمپورت نسبی: توسط vitest هم لود می‌شود
+import { getVerifiedPhoneHash } from '../sms/otp' // ایمپورت نسبی: توسط vitest هم لود می‌شود
+
+export type WalletTx = {
+  id: string
+  amount: number
+  kind: string
+  status: string
+  note: string | null
+  order_id: string | null
+  created_at: string
+}
+
+export type WalletView = {
+  balance: number
+  transactions: WalletTx[]
+}
+
+// مبالغ به تومان؛ سقف/کف منطقی برای جلوگیری از ورودی‌های مسخره
+export const WALLET_MIN_AMOUNT = 5_000
+export const WALLET_MAX_AMOUNT = 10_000_000
+
+export const WALLET_KIND_LABELS: Record<string, string> = {
+  admin_charge: 'شارژ توسط ادمین',
+  online_charge: 'شارژ آنلاین',
+  refund: 'بازگشت وجه',
+  spend: 'خرج سفارش',
+}
+
+export function isValidWalletAmount(v: unknown): v is number {
+  return (
+    typeof v === 'number' &&
+    Number.isInteger(v) &&
+    v >= WALLET_MIN_AMOUNT &&
+    v <= WALLET_MAX_AMOUNT
+  )
+}
+
+export function walletKindLabel(kind: string): string {
+  return WALLET_KIND_LABELS[kind] ?? kind
+}
+
+/**
+ * مشتریِ کیف‌پول‌دار = کسی که نشست «تلفن تأییدشده» دارد.
+ * کوکی فقط هش تلفن است؛ با ستون customers.phone_hash به رکورد مشتری می‌رسیم.
+ */
+export async function resolveWalletCustomer(): Promise<{ id: string; phone_hash: string } | null> {
+  const phoneHash = await getVerifiedPhoneHash()
+  if (!phoneHash) return null
+
+  const { data, error } = await supabaseAdmin()
+    .from('customers')
+    .select('id, phone_hash')
+    .eq('phone_hash', phoneHash)
+    .maybeSingle()
+
+  if (error) {
+    console.error('[wallet] resolve failed:', error.message)
+    return null
+  }
+  return data ?? null
+}
+
+export async function getWalletView(customerId: string): Promise<WalletView> {
+  const db = supabaseAdmin()
+
+  const { data: balanceData, error: balanceError } = await db.rpc('wallet_balance', {
+    p_customer_id: customerId,
+  })
+  if (balanceError) {
+    console.error('[wallet] balance rpc failed:', balanceError.message)
+    throw new Error('خطا در خواندن موجودی')
+  }
+
+  const { data: tx, error: txError } = await db
+    .from('wallet_transactions')
+    .select('id, amount, kind, status, note, order_id, created_at')
+    .eq('customer_id', customerId)
+    .order('created_at', { ascending: false })
+    .limit(50)
+
+  if (txError) {
+    console.error('[wallet] tx read failed:', txError.message)
+    throw new Error('خطا در خواندن تراکنش‌ها')
+  }
+
+  return {
+    balance: Number(balanceData ?? 0),
+    transactions: (tx ?? []) as WalletTx[],
+  }
+}
+
+/** شارژ توسط ادمین بر اساس شماره تلفن مشتری */
+export async function adminChargeByPhone(
+  phone: string,
+  amount: number,
+  note: string | null
+): Promise<{ ok?: boolean; error?: string }> {
+  const db = supabaseAdmin()
+  const { data: customer } = await db
+    .from('customers')
+    .select('id')
+    .eq('phone', phone)
+    .maybeSingle()
+
+  if (!customer?.id) {
+    return { error: 'مشتری با این شماره یافت نشد. باید حداقل یک‌بار سفارش داده یا با OTP ورود کند.' }
+  }
+
+  const { error } = await db.rpc('wallet_charge', {
+    p_customer_id: customer.id,
+    p_amount: amount,
+    p_kind: 'admin_charge',
+    p_note: note,
+  })
+  if (error) {
+    console.error('[wallet] charge rpc failed:', error.message)
+    return { error: 'شارژ ناموفق بود' }
+  }
+  return { ok: true }
+}
+
+/** نمای کیف پول برای ادمین، بر اساس شماره تلفن */
+export async function adminWalletByPhone(phone: string): Promise<WalletView | null> {
+  const db = supabaseAdmin()
+  const { data: customer } = await db
+    .from('customers')
+    .select('id')
+    .eq('phone', phone)
+    .maybeSingle()
+
+  if (!customer?.id) return null
+  return getWalletView(customer.id)
+}
diff --git a/supabase/migrations/20261108_wallet_v1.sql b/supabase/migrations/20261108_wallet_v1.sql
new file mode 100644
index 0000000..872f2b7
--- /dev/null
+++ b/supabase/migrations/20261108_wallet_v1.sql
@@ -0,0 +1,95 @@
+-- کیف پول مشتری — بخش ۱: زیرساخت (پچ ۱۷)
+-- جدول wallet_transactions از قبل وجود دارد؛ این مایگریشن ستون‌های لازم را
+-- به‌صورت idempotent هم‌تراز می‌کند و توابع اتمیک موجودی/خرج/شارژ را می‌سازد.
+
+-- هویت: پیوند نشست OTP (کوکی هش تلفن) به مشتری
+alter table public.customers add column if not exists phone_hash text;
+create unique index if not exists customers_phone_hash_uq
+  on public.customers (phone_hash) where phone_hash is not null;
+
+-- هم‌ترازسازی ستون‌های دفتر کیف پول
+alter table public.wallet_transactions add column if not exists customer_id uuid;
+alter table public.wallet_transactions add column if not exists amount bigint;
+alter table public.wallet_transactions add column if not exists kind text;
+alter table public.wallet_transactions add column if not exists status text default 'settled';
+alter table public.wallet_transactions add column if not exists order_id uuid;
+alter table public.wallet_transactions add column if not exists note text;
+alter table public.wallet_transactions add column if not exists created_at timestamptz default now();
+
+create index if not exists wallet_tx_customer_idx
+  on public.wallet_transactions (customer_id, created_at desc);
+
+-- کلید روشن/خاموش کیف پول (تا تست کامل نشده خاموش می‌ماند)
+alter table public.settings add column if not exists wallet_enabled boolean default false;
+
+-- موجودی = جمع تراکنش‌های تسویه‌شده (رقم مثبت = شارژ، منفی = خرج)
+create or replace function public.wallet_balance(p_customer_id uuid)
+returns bigint
+language sql
+security definer
+set search_path to 'public'
+as $$
+  select coalesce(sum(amount), 0)::bigint
+  from wallet_transactions
+  where customer_id = p_customer_id and status = 'settled';
+$$;
+
+-- برداشت اتمیک: فقط اگر موجودی کافی باشد. قفل مشاوره‌ای روی مشتری،
+-- جلوی دو خرج هم‌زمان را می‌گیرد (نتایج منفی غیرممکن می‌شود).
+create or replace function public.wallet_try_spend(
+  p_customer_id uuid,
+  p_amount bigint,
+  p_order_id uuid,
+  p_note text default null
+)
+returns boolean
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+declare
+  v_balance bigint;
+begin
+  if p_amount is null or p_amount <= 0 then
+    raise exception 'invalid_amount';
+  end if;
+
+  perform pg_advisory_xact_lock(hashtextextended(p_customer_id::text, 0));
+
+  select wallet_balance(p_customer_id) into v_balance;
+  if v_balance < p_amount then
+    return false;
+  end if;
+
+  insert into wallet_transactions (customer_id, amount, kind, status, order_id, note)
+  values (p_customer_id, -p_amount, 'spend', 'settled', p_order_id, p_note);
+
+  return true;
+end $$;
+
+-- شارژ: توسط ادمین (و در آینده پرداخت آنلاین)
+create or replace function public.wallet_charge(
+  p_customer_id uuid,
+  p_amount bigint,
+  p_kind text default 'admin_charge',
+  p_note text default null
+)
+returns void
+language plpgsql
+security definer
+set search_path to 'public'
+as $$
+begin
+  if p_amount is null or p_amount <= 0 then
+    raise exception 'invalid_amount';
+  end if;
+  if p_kind not in ('admin_charge', 'online_charge', 'refund') then
+    raise exception 'invalid_kind';
+  end if;
+  if (select wallet_balance(p_customer_id)) + p_amount > 9223372036854775807::bigint then
+    raise exception 'overflow';
+  end if;
+
+  insert into wallet_transactions (customer_id, amount, kind, status, note)
+  values (p_customer_id, p_amount, p_kind, 'settled', p_note);
+end $$;
